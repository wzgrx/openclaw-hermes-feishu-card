{
  "id": "openclaw-hermes-feishu-card",
  "name": "OpenClaw Hermes Feishu Card",
  "description": "One CardKit reply with tool progress, runtime resources, token totals and cost metrics.",
  "version": "2.0.0",
  "activation": {
    "onStartup": true
  },
  "channels": ["feishu"],
  "skills": ["./node_modules/@larksuite/openclaw-lark/skills"],
  "contracts": {
    "tools": [
      "feishu_bitable_app",
      "feishu_bitable_app_table",
      "feishu_bitable_app_table_field",
      "feishu_bitable_app_table_record",
      "feishu_bitable_app_table_view",
      "feishu_calendar_calendar",
      "feishu_calendar_event",
      "feishu_calendar_event_attendee",
      "feishu_calendar_freebusy",
      "feishu_chat",
      "feishu_chat_members",
      "feishu_create_doc",
      "feishu_doc_comments",
      "feishu_doc_media",
      "feishu_drive_file",
      "feishu_fetch_doc",
      "feishu_get_user",
      "feishu_im_bot_image",
      "feishu_im_user_fetch_resource",
      "feishu_im_user_get_messages",
      "feishu_im_user_get_thread_messages",
      "feishu_im_user_message",
      "feishu_im_user_search_messages",
      "feishu_oauth",
      "feishu_oauth_batch_auth",
      "feishu_search_doc_wiki",
      "feishu_search_user",
      "feishu_sheet",
      "feishu_task_comment",
      "feishu_task_subtask",
      "feishu_task_task",
      "feishu_task_agent",
      "feishu_task_attachment",
      "feishu_task_tasklist",
      "feishu_update_doc",
      "feishu_wiki_space",
      "feishu_wiki_space_node",
      "feishu_task_section",
      "feishu_ask_user_question"
    ]
  },
  "channelConfigs": {
    "feishu": {
      "schema": {
        "type": "object"
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "embeddedLark": {
        "type": "boolean",
        "default": true
      },
      "captureChannels": {
        "type": "array",
        "items": { "type": "string" },
        "default": ["feishu"]
      },
      "title": {
        "type": "string",
        "default": "OpenClaw"
      },
      "accountTitles": {
        "type": "object",
        "additionalProperties": { "type": "string" },
        "default": {}
      },
      "timezone": {
        "type": "string",
        "default": "Asia/Shanghai"
      },
      "storageDir": {
        "type": "string"
      },
      "legacyTaskDir": {
        "type": "string",
        "default": "/tmp/openclaw-tasks"
      },
      "balanceCachePath": {
        "type": "string"
      },
      "updateIntervalMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 10000,
        "default": 800
      },
      "panels": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reasoning": { "type": "boolean", "default": true },
          "tools": { "type": "boolean", "default": true },
          "progress": { "type": "boolean", "default": true },
          "resources": { "type": "boolean", "default": false },
          "footer": { "type": "boolean", "default": true }
        }
      },
      "footer": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": { "type": "boolean", "default": true },
          "elapsed": { "type": "boolean", "default": true },
          "firstToken": { "type": "boolean", "default": true },
          "model": { "type": "boolean", "default": true },
          "tokens": { "type": "boolean", "default": true },
          "cache": { "type": "boolean", "default": true },
          "context": { "type": "boolean", "default": true },
          "cost": { "type": "boolean", "default": true },
          "totals": { "type": "boolean", "default": false },
          "todayTokens": { "type": "boolean", "default": false },
          "monthTokens": { "type": "boolean", "default": false },
          "backgroundTasks": { "type": "boolean", "default": false },
          "balance": { "type": "boolean", "default": false }
        }
      },
      "pricing": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["pattern", "inputPerMillion", "outputPerMillion"],
          "additionalProperties": false,
          "properties": {
            "pattern": { "type": "string" },
            "currency": {
              "type": "string",
              "enum": ["CNY", "USD"],
              "default": "CNY"
            },
            "inputPerMillion": { "type": "number", "minimum": 0 },
            "outputPerMillion": { "type": "number", "minimum": 0 },
            "cacheReadPerMillion": { "type": "number", "minimum": 0 },
            "cacheWritePerMillion": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
